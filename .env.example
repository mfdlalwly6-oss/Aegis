# ═══════════════════════════════════════════════════════════════
# AEGIS — Multi-Tenant Fraud Detection Platform
# تنبيه: انسخ هذا الملف إلى .env وعدّل القيم — لا ترفع .env إلى Git أبدًا
# ═══════════════════════════════════════════════════════════════
AEGIS_ENV=development
AEGIS_VERSION=2.2.0
PORT=8000
AEGIS_PUBLIC_URL=http://localhost:8000

# أسرار — استبدلها بقيم عشوائية طويلة في الإنتاج
AEGIS_SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars
AEGIS_OWNER_TOKEN=change-me-owner-token
AEGIS_LEGACY_SECRET=

# البيانات
AEGIS_DATA_DIR=/data
AEGIS_DB_PATH=/data/aegis.db

# ─── PostgreSQL storage (TASK 1) ──────────────────────────────
# AEGIS is PostgreSQL-only. The ONLY supported database is PostgreSQL.
# There is no SQLite driver, no SQLite fallback, no dev/test SQLite mode.
# AEGIS_DB_DRIVER is always postgres (set explicitly for clarity).
AEGIS_DB_DRIVER=postgres
# postgresql://user:pass@host:5432/db — REQUIRED. App fails fast if unreachable.
AEGIS_DATABASE_URL=postgresql://aegis:change-me-postgres-password@localhost:5432/aegis
# Password for the compose-managed PostgreSQL service (aegis-postgres)
POSTGRES_PASSWORD=change-me-postgres-password

# CORS + Rate limit
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MIN=240

# AI (اختياري — بدون مفتاح يعمل النظام بوضع التحليل المحلي)
AI_ENABLED=false
AI_MIN_SCORE=0.45
OPENROUTER_KEYS=your-openrouter-key-here

# حدود القرار (تُقرأ من النظام — غير مثبتة في الكود)
DECISION_THRESHOLD_CHALLENGE=0.35
DECISION_THRESHOLD_REVIEW=0.60
DECISION_THRESHOLD_BLOCK=0.80

# أوزان دمج المخاطر (مجموعها 1.0)
WEIGHT_RULES=0.35
WEIGHT_ML=0.25
WEIGHT_GRAPH=0.15
WEIGHT_AML=0.15
WEIGHT_BEHAVIOR=0.10

# محقق أولي اختياري عند أول تشغيل (يُربط بأول مؤسسة نشطة أو INV_TENANT_ID)
AEGIS_INVESTIGATOR_EMAIL=
AEGIS_INVESTIGATOR_PASSWORD=
AEGIS_INVESTIGATOR_NAME=محقق الاحتيال
AEGIS_INVESTIGATOR_TENANT_ID=

# Platform admin bootstrap (no hardcoded credentials; used once at first boot)
AEGIS_PLATFORM_ADMIN_EMAIL=
AEGIS_PLATFORM_ADMIN_PASSWORD=

AEGIS_NOTIFICATION_PROVIDER=console
AEGIS_NOTIFICATION_WEBHOOK_URL=
AEGIS_NOTIFICATION_WEBHOOK_SECRET=
AEGIS_NOTIFICATION_TIMEOUT_SEC=5
AEGIS_NOTIFICATION_RETRIES=2

# SMTP notification provider (AEGIS_NOTIFICATION_PROVIDER=smtp)
AEGIS_NOTIFICATION_SMTP_HOST=
AEGIS_NOTIFICATION_SMTP_PORT=587
AEGIS_NOTIFICATION_SMTP_USER=
AEGIS_NOTIFICATION_SMTP_PASSWORD=
AEGIS_NOTIFICATION_SMTP_FROM=
AEGIS_NOTIFICATION_SMTP_TO=
AEGIS_NOTIFICATION_SMTP_USE_TLS=true
