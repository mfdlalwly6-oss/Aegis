# ═══════════ AEGIS Environment Configuration ═══════════
# Copy to .env and fill real values. NEVER commit .env.

AEGIS_ENV=development
AEGIS_VERSION=2.0.0
PORT=8000

# Public base URL of this AEGIS instance (used in portal integration examples)
AEGIS_PUBLIC_URL=http://localhost:8000

# JWT signing secret — CHANGE in production (min 32 chars)
AEGIS_SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars

# Platform owner token — CHANGE in production
AEGIS_OWNER_TOKEN=change-me-owner-token

# Data directory (SQLite lives here) — keep on a Docker volume
AEGIS_DATA_DIR=/data
AEGIS_DB_PATH=/data/aegis.db

# Optional fallback secret for legacy tenants (leave empty to disable legacy fallback)
AEGIS_LEGACY_SECRET=

# CORS — comma separated origins, never use * in production
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Rate limiting
RATE_LIMIT_PER_MIN=240

# OpenRouter AI explanations (optional — system works without keys)
OPENROUTER_KEYS=your-openrouter-key-here
AI_ENABLED=true
AI_MIN_SCORE=0.45

# Decision thresholds (platform defaults; tenants can override via policies)
DECISION_THRESHOLD_CHALLENGE=0.35
DECISION_THRESHOLD_REVIEW=0.60
DECISION_THRESHOLD_BLOCK=0.80

# Risk fusion weights (must sum to 1.0)
WEIGHT_RULES=0.35
WEIGHT_ML=0.25
WEIGHT_GRAPH=0.15
WEIGHT_AML=0.15
WEIGHT_BEHAVIOR=0.10
